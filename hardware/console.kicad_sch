	(text "Powered by either\n* USB-C module (J1), 5V on VBUS\n* 3 AAA batteries (J2)\nUSB takes precedence via Q1; no battery charging."
		(exclude_from_sim no)
		(at 14.478 23.368 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4c0f9af3-ac33-4ab2-92ae-d7185e6fcafd")
	)
	(text "LS1 is a PIEZO buzzer - a capacitive load, not a coil.\n<=10 mA at 4 kHz / 5 Vpp, so PA8 drives it directly:\nno transistor and no flyback diode needed.\nDrive at 4 kHz +/-500 (resonance) for max SPL.\nR6 only softens the edges so the capacitive inrush\ndoes not couple into the 3V3 rail / OLED. 0R is fine.\nOn 3V3 single-ended expect ~3 dB below the 5 Vpp spec.\nWant it louder: drive TIM1_CH1 (PA8) against\nTIM1_CH1N (PA7) for 6.6 Vpp differential, +6 dB,\nno extra parts - just move LS1 pin 2 off GND to PA7."
		(exclude_from_sim no)
		(at 33.02 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5b00000d-0000-4000-8000-000000000001")
	)
	(text "Debug Connectors"
		(exclude_from_sim no)
		(at 151.384 16.51 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "7a2abf9b-bfd1-4702-a942-ecc9ee3d77a4")
	)
	(text "Power Supply"
		(exclude_from_sim no)
		(at 23.876 16.764 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "89f62335-0b0f-4484-a24b-682b6fa6a43b")
	)
	(text "Mounting Holes"
		(exclude_from_sim no)
		(at 28.702 172.974 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.3556)
				(bold yes)
			)
		)
		(uuid "a0dd3435-d48e-45c8-bf53-6997f174e909")
	)
	(text "Pin usage:\n* PB6/PB7 = I2C1 SCL/SDA -> DS1 display\n  DMA1 via DMAMUX; PB8/PB9 is the alt pair\n* PA8 = TIM1_CH1 -> LS1 piezo, direct drive\n  spares: PA6/PA7, PB8/PB9\n\nButtons: PB0..PB5, active low.\nUse the internal pull-ups (~40k), no externals.\nAll six read as GPIOB->IDR & 0x3F.\n\nNote: PA14 is shared with BOOT0. Safe with the\ndefault option bytes (nBOOT_SEL=1)."
		(exclude_from_sim no)
		(at 165.1 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d5000001-0000-4000-8000-000000000001")
	)
	(text "DS1: 0.96\" OLED, SSD1315, LCSC C5248080\nVCC abs max 3.3V. Rail is XC6206P332 (3.3V\n+/-2%) = up to 3.366V: zero margin, see notes.\nI2C addr 0x3C 7-bit (0x78 write), SA0=0\n32mA max with the panel fully lit\nR4/R5 = bus pull-ups; fit as DNP if the\nmodule already carries its own."
		(exclude_from_sim no)
		(at 182.88 158.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d5000001-0000-4000-8000-000000000002")
	)
	(text "Speaker"
		(exclude_from_sim no)
		(at 25.4 109.728 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "e5733e95-0acf-4364-b868-7b7146731922")
	)
