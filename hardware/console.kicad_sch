	(text "GPIOs all have internal pull-ups"
		(exclude_from_sim no)
		(at 210.82 84.074 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0877806e-6996-4fe6-b8f0-8477910ebcb1")
	)
	(text "Do NOT trust a single readout for the state of charge,\ndo the average of multiple spaced-out readings"
		(exclude_from_sim no)
		(at 204.978 20.828 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "0e41216d-0c7a-4c61-9839-825f00522541")
	)
	(text "TP4054, by datasheet with I_batt=0.5 * mAh_batt\nI_batt <  100mA: R_prog=1000/I_batt \nI_batt >= 100mA: R_prog=1000/I_batt * (1.2 - 4/3 * I_batt)"
		(exclude_from_sim no)
		(at 102.362 70.866 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3323da0e-48de-403c-a10c-d2e12978484c")
	)
	(text "USB 5V charges the LiPo through U3\nand also runs the board. VBAT_LIPO is 3.0-4.2V,\nso the 3.3V rail drops out below ~3.5V.\nUse a pack with a built-in protection PCM."
		(exclude_from_sim no)
		(at 42.926 69.088 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3a85f8af-c8b7-4239-b97d-0a876a712c21")
	)
